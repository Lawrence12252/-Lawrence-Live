  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body { background-color: #090812; color: #FFFFFF; font-family: 'Tajawal', 'Plus Jakarta Sans', sans-serif; user-select: none; overflow-x: hidden; }
    .gold-glow { box-shadow: 0 0 25px rgba(245, 158, 11, 0.55); }
    .purple-glow { box-shadow: 0 0 25px rgba(139, 92, 246, 0.55); }
    .active-press:active { transform: scale(0.92); transition: transform 0.08s ease; }
    .gift-anim { animation: giftPop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    @keyframes giftPop {
      0% { transform: scale(0.2) rotate(-15deg); opacity: 0; }
      50% { transform: scale(1.3) rotate(10deg); opacity: 1; }
      75% { transform: scale(1.1) rotate(-5deg); opacity: 1; }
      100% { transform: scale(1) rotate(0deg); opacity: 0; }
    }
    .shake-screen { animation: screenShake 0.4s ease-in-out; }
    @keyframes screenShake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px) rotate(-0.5deg); }
      40%, 80% { transform: translateX(6px) rotate(0.5deg); }
    }
  </style>
</head>
